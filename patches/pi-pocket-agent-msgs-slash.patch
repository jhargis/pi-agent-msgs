+    assert.equal(old.status, 409);
+    assert.match(String(old.body.error), /Update/);
+    writeFileSync(moduleFile, moduleSource);
+    await app.loader.reload("pi-agent-msgs.ts");
+    await app.setExtensionEnabled(owner(app), "pi-agent-msgs.ts", false);
+    assert.equal(app.loader.registeredTask("pi-agent-msgs.reporting-command"), undefined);
+    assert.equal((await request({ action: "on" })).status, 409);
+    await app.setExtensionEnabled(owner(app), "pi-agent-msgs.ts", true);
+    assert.equal(calls, 0);
+});
+
+const chromium = findBrowser();
+const real = { skip: chromium === undefined ? "no Chromium-based browser" : false };
+
+async function inPage<T>(script: string): Promise<T> {
+    return JSON.parse(await page.evaluate(script)) as T;
+}
+
+const fill = async (text: string) => {
+    await page.evaluate(
+        `const box = document.querySelector("textarea"); box.value = ${JSON.stringify(text)}; box.dispatchEvent(new Event("input", {bubbles: true}));`,
+    );
+    await until(
+        async () =>
+            await inPage<boolean>(
+                "return JSON.stringify(document.querySelector('button[aria-label=\"Send\"]')?.disabled === false)",
+            ),
