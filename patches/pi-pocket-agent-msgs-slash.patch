+
+test("an older drop-in gets a clear update error and a disabled module exposes no task", async () => {
+    writeFileSync(
+        moduleFile,
+        'import { defineExtension } from "@earendil-works/pi-durable"; export default () => defineExtension({name: "pi-agent-msgs"});',
