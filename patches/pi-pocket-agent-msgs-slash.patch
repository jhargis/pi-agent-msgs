+
+test("guests/viewers cannot inspect or change the setting", async () => {
+    for (const role of ["guest", "viewer"] as const) {
+        const person = app.config.addUser(role, role);
+
+        for (const action of ["on", "off", "status"]) {
+            assert.equal((await request({ action }, person.token)).status, 403);
+        }
+    }
+
+    assert.equal(calls, 0);
+});
+
