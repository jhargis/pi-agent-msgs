+// The slash integration runs a fixed, owner-checked extension task, never a generation or arbitrary tool.
+import {
+    type App,
+    cleanUp,
+    context,
+    modelTexts,
+    openApp,
+    owner,
+    recordCost,
+    root,
+    scriptedModel,
+    until,
+    work,
+} from "./helpers.ts";
+import assert from "node:assert/strict";
+import { mkdirSync, writeFileSync } from "node:fs";
+import { createServer, type Server } from "node:http";
+import { join } from "node:path";
+import { after, before, test } from "node:test";
+import { fauxAssistantMessage, fauxText } from "@earendil-works/pi-ai/providers/faux";
+import type { ConversationId } from "@earendil-works/pi-durable";
+import { Browsers } from "../src/server/browser.ts";
+import { findBrowser } from "../src/server/browser/discovery.ts";
+import type { BrowserPage } from "../src/server/browser/page.ts";
+import { VIEWPORTS } from "../src/server/browser/viewport.ts";
+import { createHandler } from "../src/server/http.ts";
+
+const dropIns = join(root, "data/extensions");
+const moduleFile = join(dropIns, "pi-agent-msgs.ts");
+// Standalone contract fixture: core tests do not require the separately installed pi-agent-msgs project.
+const moduleSource = `/** Test the pi-agent-msgs slash contract. */
+import { defineDoc, defineExtension, defineTask } from "@earendil-works/pi-durable";
+const State = defineDoc({ kind: "test.agent-msgs", version: 1, scope: "conversation", history: "latest", fork: "initial", initial: () => ({ reporting: false }) });
+const command = defineTask({
+    name: "pi-agent-msgs.reporting-command", version: 1, initial: () => ({ phase: "run" }),
+    phases: { run: async (task, runtime, context) => runtime.commit(async (tx) => {
+        const doc = await tx.doc(State, runtime.conversationId);
+        if (task.input.action !== "status") doc.reporting = task.input.action === "on";
+        return { status: "terminal", outcome: { status: "completed", result: { reporting: doc.reporting, by: task.input.by } } };
+    }, context) },
+    abort: (_task, runtime, context) => runtime.commit(() => ({ status: "terminal", outcome: { status: "aborted" } }), context),
+});
+export default () => defineExtension({ name: "pi-agent-msgs", tasks: [command] });
+`;
+let app: App;
+let server: Server;
+let base: string;
+let target: ConversationId;
+let calls = 0;
+let browsers: Browsers | undefined;
+let page: BrowserPage;
+
+before(async () => {
+    mkdirSync(dropIns, { recursive: true });
+    writeFileSync(moduleFile, moduleSource);
+    app = await openApp(
+        scriptedModel(() => {
+            calls++;
+
+            return fauxAssistantMessage([fauxText("A model should not receive slash commands.")]);
+        }),
+    );
+    ({ id: target } = await app.commands.createSession(owner(app), { cwd: work }));
+    server = createServer(
+        createHandler({ app, listen: { host: "127.0.0.1", port: 0 }, restart: () => {} }),
+    );
+    await new Promise<void>((done) => server.listen(0, "127.0.0.1", done));
+    base = `http://127.0.0.1:${(server.address() as { port: number }).port}`;
+});
+after(async () => {
+    await browsers?.closeAll({ final: true });
+    server?.closeAllConnections();
+    server?.close();
+    await app?.close();
+    cleanUp();
+});
+
+const request = async (body: unknown, token = app.config.ownerToken, pocket = true) => {
+    const response = await fetch(`${base}/api/c/${target}/agent-msgs`, {
+        method: "POST",
+        headers: {
+            authorization: `Bearer ${token}`,
+            "content-type": "application/json",
+            ...(pocket ? { "X-Pocket": "1" } : {}),
+        },
+        body: JSON.stringify(body),
+    });
+
+    return { status: response.status, body: (await response.json()) as Record<string, unknown> };
+};
+
+test("requires the enabled, compatible extension and validates input before creating work", async () => {
+    assert.equal((await request({ action: "status" })).status, 409);
+    await app.setExtensionEnabled(owner(app), "pi-agent-msgs.ts", true);
+    assert.equal((await request({ action: "watch_on" })).status, 400);
+    assert.equal((await request({})).status, 400);
+    assert.equal((await request({ action: "on" }, app.config.ownerToken, false)).status, 403);
+    assert.equal(calls, 0);
+    assert.deepEqual(await modelTexts(app, target), []);
