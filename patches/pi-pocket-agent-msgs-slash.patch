+    await app.spend.setSessionBudget(owner(app), target, 0.01);
+    await recordCost(app, target, 0.01);
+    assert.equal((await request({ action: "on" })).status, 200);
+    assert.equal((await request({ action: "off" })).status, 200);
+    assert.equal(calls, 0);
+    await app.spend.setSessionBudget(owner(app), target, null);
