+    assert.equal((await request({ action: "on" })).body.reporting, true);
+    assert.equal((await request({ action: "status" })).body.reporting, true);
+    assert.equal((await request({ action: "off" })).body.reporting, false);
+    assert.equal((await request({ action: "status" })).body.reporting, false);
+    assert.equal(calls, 0);
+    assert.deepEqual(await modelTexts(app, target), []);
+    assert.equal(app.isBusy(target), false);
